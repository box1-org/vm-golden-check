# Default boot target for vm-golden-check. It keeps the normal multi-user system
# (networking, sshd, getty, qemu-guest-agent) and adds this appliance's services.
# Add your own units with WantedBy=vm-golden-check.target, or list them in Wants=.
[Unit]
Description=vm-golden-check appliance
Requires=multi-user.target
After=multi-user.target
Wants=vm-golden-check-heartbeat.service box1-registry-setup.service
AllowIsolate=yes
